import pandas as pd
import pytest

from summary import promotion_utils


# ============================================================
# calculate_composite_score
# ============================================================

def test_calculate_composite_score():
    """Verify weighted composite score is calculated correctly."""

    eval_df = pd.DataFrame({
        "model_name": ["model_1", "model_2"],
        "factual_consistency": [0.80, 0.70],
        "bert_f1": [0.90, 0.80],
        "rougeL": [0.70, 0.60],
        "meteor": [0.60, 0.50],
    })

    result = promotion_utils.calculate_composite_score(eval_df)

    assert "composite_score" in result.columns
    assert result.loc[0, "composite_score"] == pytest.approx(0.78)
    assert result.loc[1, "composite_score"] == pytest.approx(0.68)


def test_calculate_composite_score_empty_dataframe():
    """Verify an empty dataframe is returned unchanged."""

    eval_df = pd.DataFrame()

    result = promotion_utils.calculate_composite_score(eval_df)

    assert result.empty
    assert result is not eval_df


def test_calculate_composite_score_missing_column():
    """Verify missing composite inputs raise ValueError."""

    eval_df = pd.DataFrame({
        "model_name": ["model_1"],
        "bert_f1": [0.90],
        "rougeL": [0.70],
    })

    with pytest.raises(
        ValueError,
        match="Missing composite score inputs",
    ):
        promotion_utils.calculate_composite_score(eval_df)


def test_calculate_composite_score_invalid_weights(monkeypatch):
    """Verify weights must sum to one."""

    monkeypatch.setattr(
        promotion_utils,
        "_COMPOSITE_INPUTS",
        {
            "bert_f1": 0.30,
            "rougeL": 0.20,
        },
    )

    eval_df = pd.DataFrame({
        "bert_f1": [0.90],
        "rougeL": [0.70],
    })

    with pytest.raises(
        ValueError,
        match="weights must sum to 1.0",
    ):
        promotion_utils.calculate_composite_score(eval_df)


