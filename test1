                model_input,
                model_output,
            )

            assert log_transformer_model(
                model_name=model_name,
                model_pipeline=model_pipeline,
                signature=signature,
            )

            model_uri = f"runs:/{run_id}/{model_name}"

            loaded_model = mlflow.pyfunc.load_model(model_uri)

            sqlite_input = stored_df[
                stored_df["model_name"] == model_name
            ][["input_text"]].rename(
                columns={"input_text": "text"}
            )

            result = loaded_model.predict(sqlite_input)

            assert result is not None
            assert len(result) == len(sqlite_input)


