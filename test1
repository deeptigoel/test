def test_mlflow_run_logs_metadata(mock_mlflow):
    """Verify MLflow run metadata is logged."""

    from mlflow_utils import (
        setup_experiment,
        set_run_tags,
        log_parameters,
        log_metrics,
    )

    setup_experiment("test_experiment")
    set_run_tags(
        run_type="inference",
        capability="summarization",
        dataset_version="v1",
    )
    log_parameters({"model_name": "test_model"})
    log_metrics({"composite_score": 0.85})

    mock_mlflow.set_experiment.assert_called_once_with(
        "test_experiment"
    )
    mock_mlflow.set_tags.assert_called_once_with({
        "run_type": "inference",
        "capability": "summarization",
        "dataset_version": "v1",
    })
    mock_mlflow.log_params.assert_called_once_with({
        "model_name": "test_model"
    })
    mock_mlflow.log_metrics.assert_called_once_with({
        "composite_score": 0.85
    })
