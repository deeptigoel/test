def test_rank_models():
    """Verify models are ranked by composite score descending."""

    eval_df = pd.DataFrame({
        "model_name": ["model_1", "model_2", "model_3"],
        "composite_score": [0.70, 0.90, 0.80],
    })

    result = promotion_utils._rank_models(eval_df)

