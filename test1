    Verifies summarization prediction → SQLite storage → MLflow logging →
    model retrieval → schema-enforced prediction.
    """

    # Start/configure real MLflow server
    configure_mlflow()

    combined_text = (
        "This is a sample document used to validate the summarization pipeline."
    )

    # Actual production pipeline
    summary_results, models = run_pipeline(combined_text)

    # Store prediction results locally
    db_path = tmp_path / "mlflow_summ.db"

    with sqlite3.connect(db_path) as conn:
        conn.execute(
            """
            CREATE TABLE predictions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                input_text TEXT NOT NULL,
                model_name TEXT NOT NULL,
                prediction TEXT NOT NULL
            )
            """
        )

        for model_name, prediction in summary_results.items():
            conn.execute(
                """
                INSERT INTO predictions
                (input_text, model_name, prediction)
                VALUES (?, ?, ?)
                """,
                (combined_text, model_name, prediction),
            )

        conn.commit()

        stored_df = pd.read_sql(
            "SELECT input_text, model_name, prediction FROM predictions",
            conn,
        )

    assert not stored_df.empty
    assert {"input_text", "model_name", "prediction"} <= set(stored_df.columns)

    # Real MLflow run
    with mlflow.start_run() as run:
        run_id = run.info.run_id

        mlflow.log_param("input_source", "sqlite")
        mlflow.log_metric("prediction_count", len(stored_df))

        for model_name, model_pipeline in models.items():

            model_input = pd.DataFrame(
                {"text": [combined_text]}
            )

            raw_prediction = model_pipeline(combined_text)

            model_output = pd.DataFrame(
                {
                    "prediction": [
                        raw_prediction[0]["summary_text"]
                    ]
                }
            )

