def test_promote_models_success(monkeypatch):
    """Verify Champion and Challenger are promoted successfully."""

    monkeypatch.setattr(
        promotion_utils,
        "logger",
        __import__("logging").getLogger(__name__),
    )

    eval_df = pd.DataFrame({
        "model_name": ["model_1", "model_2"],
        "composite_score": [0.90, 0.80],
    })

    result = promotion_utils.promote_models(eval_df)

    assert result["promotion_status"] == "completed"

    assert result["champion"]["model_name"] == "model_1"
    assert result["challenger"]["model_name"] == "model_2"

    assert result["champion_score"] == 0.90
    assert result["challenger_score"] == 0.80

    assert result["aliases"] == {
        "model_1": "Champion",
        "model_2": "Challenger",
    }

    assert result["promotion_blocked_reason"] is None


